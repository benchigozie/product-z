enum PropertyType {
  @@type("pg/text@1")

  ESTATE
  COMPOUND
  BUILDING
  HOUSE
  APARTMENT
  HOSTEL
  UNIT
  SHOP
  OFFICE
  WAREHOUSE
  LAND
}

enum PropertyRelationshipType {
  @@type("pg/text@1")

  CONTAINS
}

enum PlaceType {
  @@type("pg/text@1")

  DISTRICT
  SUBDISTRICT
  AREA
}

model Country {
  id     String @id @default(cuid(2))
  name   String
  code   String @unique

  states State[]
}

model State {
  id        String @id @default(cuid(2))
  name      String
  code      String
  countryId String

  country    Country    @relation(fields: [countryId], references: [id])
  places     Place[]
  properties Property[]

  @@unique([countryId, code])
}

model Place {
  id            String    @id @default(cuid(2))
  name          String
  type          PlaceType

  stateId       String
  parentPlaceId String?

  latitude      Float?
  longitude     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  state       State @relation(fields: [stateId], references: [id])
  parentPlace Place? @relation(
    "PlaceHierarchy",
    fields: [parentPlaceId],
    references: [id]
  )
  childPlaces Place[] @relation("PlaceHierarchy")

  properties Property[]
  observations Observation[]
  intelligence Intelligence?
}

model Property {
  id           String       @id @default(cuid(2))
  name         String?
  propertyType PropertyType

  countryId String
  stateId   String
  placeId   String?

  address        String?
  street         String?
  houseNumber    String?
  unitIdentifier String?
  landmark       String?

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  country Country @relation(fields: [countryId], references: [id])
  state   State   @relation(fields: [stateId], references: [id])
  place   Place?  @relation(fields: [placeId], references: [id])

  bedrooms        Int?
  bathrooms       Int?
  sizeSqm         Float?

  isProvisional   Boolean @default(false)
  createdByUserId String?
  mergedIntoId    String?

  observations Observation[]
  parentRelationships PropertyRelationship[] @relation("PropertyAsParent")
  childRelationships  PropertyRelationship[] @relation("PropertyAsChild")
  userRelationships UserPropertyRelationship[]
  intelligence Intelligence?
  verificationReports VerificationReport[]

  createdBy  User?      @relation("PropertyCreatedBy", fields: [createdByUserId], references: [id])
  mergedInto Property?  @relation("PropertyMergedInto", fields: [mergedIntoId], references: [id])
  mergedFrom Property[] @relation("PropertyMergedInto")

  listings Listing[]
  media    PropertyMedia[]

  mergesFrom PropertyMerge[] @relation("PropertyMergeFrom")
  mergesTo   PropertyMerge[] @relation("PropertyMergeTo")

  referrals   ListingReferral[]
  inspections Inspection[]
  
  matchSuggestionsAsSource    MatchSuggestion[] @relation("MatchSuggestionSource")
  matchSuggestionsAsCandidate MatchSuggestion[] @relation("MatchSuggestionCandidate")
}

model PropertyRelationship {
  id String @id @default(cuid(2))

  parentPropertyId String
  childPropertyId  String @unique

  relationshipType PropertyRelationshipType

  createdAt DateTime @default(now())

  parentProperty Property @relation(
    "PropertyAsParent",
    fields: [parentPropertyId],
    references: [id]
  )

  childProperty Property @relation(
    "PropertyAsChild",
    fields: [childPropertyId],
    references: [id]
  )
}

enum UserStatus {
  @@type("pg/text@1")

  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum AuthProvider {
  @@type("pg/text@1")

  GOOGLE
}

enum VerificationTokenType {
  @@type("pg/text@1")

  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}


model User {
   id String @id @default(cuid(2))

  email String @unique
  emailVerified Boolean @default(false)

  status UserStatus @default(ACTIVE)

  profile UserProfile?

  passwordCredential PasswordCredential?

  oauthAccounts OAuthAccount[]

  sessions Session[]
  observations Observation[]
  propertyRelationships UserPropertyRelationship[]

  verificationTokens VerificationToken[]

  verificationReports         VerificationReport[] @relation("VerificationReportVerifier")
  reviewedVerificationReports VerificationReport[] @relation("VerificationReportReviewer")
  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()
  deletedAt DateTime?

  role UserRole @default(USER)

    listingsCreated Listing[] @relation("ListingCreatedBy")
  listingsFlagged Listing[] @relation("ListingFlaggedBy")
  mediaCreated    Media[]   @relation("MediaCreatedBy")

  inspectionsRequested Inspection[] @relation("InspectionRequester")
  inspectionsAssigned  Inspection[] @relation("InspectionInspector")
  inspectionsCancelled Inspection[] @relation("InspectionCancelledBy")

  availability           AgentAvailability[]
  availabilityExceptions AgentAvailabilityException[]

  listingReferrals ListingReferral[]

  reportsMade     Report[] @relation("ReportReporter")
  reportsResolved Report[] @relation("ReportResolver")

  propertyMergesActed    PropertyMerge[] @relation("PropertyMergeActor")
  propertyMergesReversed PropertyMerge[] @relation("PropertyMergeReverser")

  propertiesCreated Property[] @relation("PropertyCreatedBy")

}


model UserProfile {
  id String @id @default(cuid(2))

  userId String @unique

  username String? @unique
  displayName String?

  avatarUrl String?

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()
}


model PasswordCredential {
   id String @id @default(cuid(2))

  userId String @unique

  passwordHash String

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt temporal.createdAt()
}


model OAuthAccount {
   id String @id @default(cuid(2))

  userId String

  provider AuthProvider

  providerAccountId String

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt temporal.createdAt()

  @@unique([provider, providerAccountId])
}


model Session {
   id String @id @default(cuid(2))

  userId String

  tokenHash String @unique

  expiresAt DateTime

  listingReferrals ListingReferral[]

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt temporal.createdAt()

}


model VerificationToken {
   id String @id @default(cuid(2))

  userId String

  tokenHash String @unique

  type VerificationTokenType

  expiresAt DateTime

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt temporal.createdAt()

}

enum ObservationCategory {
  @@type("pg/text@1")

  POWER
  WATER
  INTERNET
  FLOODING
  ROAD_ACCESS
  DRAINAGE
  SECURITY
  WASTE
  NOISE
  BUILDING_CONDITION
  PARKING
  SANITATION
  LIGHTING
  ENVIRONMENT
  CONSTRUCTION
  OTHER
}

model Observation {
  id String @id @default(cuid(2))

  category ObservationCategory

  propertyId String?
  placeId    String?

  data        Json?
  description String?

  observedAt DateTime

  userId String?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  property Property? @relation(fields: [propertyId], references: [id])
  place    Place?    @relation(fields: [placeId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  interpretation Json?
}



enum UserPropertyRelationshipType {
  @@type("pg/text@1")

  TENANT
  RESIDENT
  AGENT
  LANDLORD
  VISITOR
  NEIGHBOR
  RANDO
}

enum RelationshipDatePrecision {
  @@type("pg/text@1")

  DAY
  MONTH
  YEAR
  INFERRED
}

model UserPropertyRelationship {
  id String @id @default(cuid(2))

  userId     String
  propertyId String

  relationshipType UserPropertyRelationshipType

  startedAt          DateTime
  startedAtPrecision RelationshipDatePrecision

  endedAt          DateTime?
  endedAtPrecision RelationshipDatePrecision?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  verificationRecords RelationshipVerification[]

  @@index([userId])
  @@index([propertyId])
  @@index([propertyId, relationshipType], name: "upr_property_type_idx")
}

enum RelationshipVerificationStatus {
  @@type("pg/text@1")
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

enum RelationshipVerificationMethod {
  @@type("pg/text@1")
  PROPERTY_EVIDENCE
  ADMIN_REVIEW
}

model RelationshipVerification {
  id             String                           @id @default(cuid(2))
  relationshipId String
  status         RelationshipVerificationStatus  @default(PENDING)
  method         RelationshipVerificationMethod
  verifiedAt     DateTime?
  expiresAt      DateTime?
  reviewerId     String?
  evidence       Json?
  createdAt      temporal.createdAt()
  updatedAt      temporal.updatedAt()

  relationship UserPropertyRelationship @relation(
    fields: [relationshipId],
    references: [id]
  )

  @@index([relationshipId])
  @@index([status])
}


enum IntelligenceStatus {
  @@type("pg/text@1")
  PENDING
  PROCESSING
  CURRENT
  FAILED
}

model Intelligence {
  id String @id @default(cuid(2))

  propertyId String? @unique
  placeId    String? @unique

  status IntelligenceStatus

  categories     Json
  overall        Json
  considerations Json

  computedAt      DateTime?
  evidenceThrough DateTime?
  failureReason   String?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  property Property? @relation(fields: [propertyId], references: [id])
  place    Place?    @relation(fields: [placeId], references: [id])

  lastRecomputeReason IntelligenceRecomputeReason?

  @@index([propertyId])
  @@index([placeId])
  @@index([status])
}

enum IntelligenceRecomputeReason {
  @@type("pg/text@1")
  NEW_OBSERVATION
  PROMPT_CHANGE
  MANUAL
  RETRY
}


enum VerificationReportScope {
  @@type("pg/text@1")
  PROPERTY
}

enum VerificationReportStatus {
  @@type("pg/text@1")
  REQUESTED
  IN_PROGRESS
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  CANCELLED
}

model VerificationReport {
  id String @id @default(cuid(2))

  propertyId String
  verifierId String

  scope  VerificationReportScope  @default(PROPERTY)
  status VerificationReportStatus @default(REQUESTED)

  recordingUrl             String?
  recordingStartedAt       DateTime?
  recordingEndedAt         DateTime?
  recordingDurationSeconds Int?

  latitude  Float?
  longitude Float?

  reviewerId  String?
  reviewNotes String?
  reviewedAt  DateTime?

  requestedAt DateTime  @default(now())
  publishedAt DateTime?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  property Property @relation(fields: [propertyId], references: [id])
  verifier User     @relation("VerificationReportVerifier", fields: [verifierId], references: [id])
  reviewer User?    @relation("VerificationReportReviewer", fields: [reviewerId], references: [id])

  @@index([propertyId])
  @@index([verifierId])
  @@index([status])
}




enum UserRole {
  @@type("pg/text@1")
  USER
  OPS
  ADMIN
}

enum ListingKind {
  @@type("pg/text@1")
  RENT
  SALE
}

enum ListingStatus {
  @@type("pg/text@1")
  DRAFT
  ACTIVE
  PAUSED
  PENDING_REVIEW
  FILLED
  EXPIRED
  WITHDRAWN
}

enum PricePeriod {
  @@type("pg/text@1")
  MONTHLY
  YEARLY
  TOTAL
}

enum FeeType {
  @@type("pg/text@1")
  LEGAL
  CAUTION
  SERVICE_CHARGE
  AGENCY
  INSPECTION_FEE
  OTHER
}

enum MediaPurpose {
  @@type("pg/text@1")
  PROPERTY_PHOTO
  LISTING_PHOTO
}

enum MediaStatus {
  @@type("pg/text@1")
  PENDING
  READY
  FAILED
  DELETED
}

enum PropertyMediaSource {
  @@type("pg/text@1")
  OWNER_UPLOAD
  LISTING_PROMOTED
  OPS_CURATED
}

enum InspectionStatus {
  @@type("pg/text@1")
  REQUESTED
  SCHEDULED
  STARTED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InspectorKind {
  @@type("pg/text@1")
  LISTING_AGENT
  PRODUCT_Z_AGENT
}

enum ReportTargetType {
  @@type("pg/text@1")
  LISTING
  AGENT
  PROPERTY
  USER
}

enum ReportReason {
  @@type("pg/text@1")
  MISREPRESENTATION
  FRAUD
  SPAM
  INAPPROPRIATE_CONTENT
  DUPLICATE_LISTING
  OTHER
}

enum ReportStatus {
  @@type("pg/text@1")
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}


model Media {
  id String @id @default(cuid(2))

  storageKey String
  url        String

  mime String
  size Int

  width           Int?
  height          Int?
  durationSeconds Int?

  purpose MediaPurpose
  status  MediaStatus @default(PENDING)

  createdByUserId String?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  createdBy User? @relation("MediaCreatedBy", fields: [createdByUserId], references: [id])

  propertyMedia PropertyMedia[]
  listingMedia  ListingMedia[]

  @@index([purpose])
  @@index([status])
  @@index([createdByUserId])
}

model PropertyMedia {
  id String @id @default(cuid(2))

  propertyId String
  mediaId    String

  sortOrder Int    @default(0)
  caption   String?
  source    PropertyMediaSource @default(OWNER_UPLOAD)

  hiddenAt        DateTime?
  hiddenByMergeId String?

  createdAt temporal.createdAt()

  property      Property      @relation(fields: [propertyId], references: [id])
  media         Media         @relation(fields: [mediaId], references: [id])
  hiddenByMerge PropertyMerge? @relation("PropertyMediaHiddenByMerge", fields: [hiddenByMergeId], references: [id])

  @@unique([propertyId, mediaId])
  @@index([propertyId, sortOrder])
}

model ListingMedia {
  id String @id @default(cuid(2))

  listingId String
  mediaId   String

  sortOrder Int    @default(0)
  caption   String?

  createdAt temporal.createdAt()

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id])

  @@unique([listingId, mediaId])
  @@index([listingId, sortOrder])
}

model Listing {
  id String @id @default(cuid(2))

  propertyId      String
  createdByUserId String

  kind   ListingKind
  status ListingStatus @default(DRAFT)

  title       String
  description String?

  displayLocation String

  bedrooms  Int?
  bathrooms Int?
  sizeSqm   Float?

  features Json?

  inspectionFeeDiscouraged Boolean @default(false)

  publishedAt DateTime?
  expiresAt   DateTime?

  flaggedAt       DateTime?
  flaggedByUserId String?
  flagReason      String?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()
  deletedAt DateTime?

  property  Property @relation(fields: [propertyId], references: [id])
  createdBy User     @relation("ListingCreatedBy", fields: [createdByUserId], references: [id])
  flaggedBy User?    @relation("ListingFlaggedBy", fields: [flaggedByUserId], references: [id])

  price ListingPrice?
  fees  ListingFee[]
  media ListingMedia[]

  inspections Inspection[]
  referrals   ListingReferral[]

  @@index([propertyId])
  @@index([createdByUserId])
  @@index([status])
  @@index([kind, status])
  @@index([expiresAt])
  @@index([publishedAt])
}

model ListingPrice {
  id String @id @default(cuid(2))

  listingId String @unique

  amount   Int 
  currency String  @default("NGN")
  period   PricePeriod
  years    Int?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ListingFee {
  id String @id @default(cuid(2))

  listingId String
  type      FeeType
  amount   Int 
  currency  String  @default("NGN")
  notes     String?

  createdAt temporal.createdAt()

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([type])
}

model AgentAvailability {
  id String @id @default(cuid(2))

  agentId String

  /// 0 = Sunday ... 6 = Saturday
  dayOfWeek Int
  startTime String
  endTime   String

  timezone String @default("Africa/Lagos")

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  agent User @relation("AgentAvailability", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@unique([agentId, dayOfWeek, startTime, endTime])
}

model AgentAvailabilityException {
  id String @id @default(cuid(2))

  agentId String
  date    Date
  reason  String?

  createdAt temporal.createdAt()

  agent User @relation("AgentAvailabilityException", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, date])
  @@index([agentId])
}

model Inspection {
  id String @id @default(cuid(2))

  propertyId String
  listingId  String

  requesterId String
  inspectorId String

  inspectorKind InspectorKind @default(LISTING_AGENT)

  status InspectionStatus @default(REQUESTED)

  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  property    Property @relation(fields: [propertyId], references: [id])
  listing     Listing  @relation(fields: [listingId], references: [id])
  requester   User     @relation("InspectionRequester", fields: [requesterId], references: [id])
  inspector   User     @relation("InspectionInspector", fields: [inspectorId], references: [id])
  cancelledBy User?    @relation("InspectionCancelledBy", fields: [cancelledByUserId], references: [id])

  review InspectionReview?

  @@index([propertyId])
  @@index([listingId])
  @@index([requesterId])
  @@index([inspectorId])
  @@index([status, scheduledAt])
}

model InspectionReview {
  id String @id @default(cuid(2))

  inspectionId String @unique

  agentRating    Int
  agentText      String?
  propertyRating Int?
  propertyText   String?

  createdAt temporal.createdAt()

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([agentRating])
}

model ListingReferral {
  id String @id @default(cuid(2))

  listingId  String
  propertyId String

  anonymousId String?
  userId      String?
  sessionId   String?

  createdAt temporal.createdAt()

  listing  Listing  @relation(fields: [listingId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
  session  Session? @relation(fields: [sessionId], references: [id])

  @@index([listingId])
  @@index([propertyId])
  @@index([userId])
  @@index([anonymousId])
}

model Report {
  id String @id @default(cuid(2))

  targetType ReportTargetType
  targetId   String

  reporterId String

  reason  ReportReason
  details String?

  status ReportStatus @default(OPEN)

  resolvedByUserId String?
  resolutionNotes  String?
  resolvedAt       DateTime?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy User? @relation("ReportResolver", fields: [resolvedByUserId], references: [id])
   matchSuggestions MatchSuggestion[] @relation("MatchSuggestionReport")

  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([status])
}

model PropertyMerge {
  id String @id @default(cuid(2))

  fromPropertyId String
  toPropertyId   String

  actorId String
  reason  String?

  reversedAt   DateTime?
  reversedById String?

  createdAt temporal.createdAt()

  fromProperty Property @relation("PropertyMergeFrom", fields: [fromPropertyId], references: [id])
  toProperty   Property @relation("PropertyMergeTo",   fields: [toPropertyId],   references: [id])
  actor        User     @relation("PropertyMergeActor",    fields: [actorId],      references: [id])
  reversedBy   User?    @relation("PropertyMergeReverser", fields: [reversedById], references: [id])

  hiddenPropertyMedia PropertyMedia[] @relation("PropertyMediaHiddenByMerge")

  matchSuggestions MatchSuggestion[] @relation("MatchSuggestionMerge")

  @@index([fromPropertyId])
  @@index([toPropertyId])
  @@index([reversedAt])
}




enum MatchSuggestionStatus {
  @@type("pg/text@1")
  PENDING
  PARTIALLY_CONFIRMED
  CONFIRMED
  DISPUTED
  EXPIRED
}

enum MatchSuggestionActorRole {
  @@type("pg/text@1")
  CREATOR
  AGENT
  LANDLORD
  TENANT
  OPS
  ADMIN
}


model MatchSuggestion {
  id String @id @default(cuid(2))

  sourcePropertyId    String
  candidatePropertyId String

  score   Float
  reasons Json

  status MatchSuggestionStatus @default(PENDING)

  sourceConfirmedByUserId String?
  sourceConfirmedByRole   MatchSuggestionActorRole?
  sourceConfirmedAt       DateTime?

  candidateConfirmedByUserId String?
  candidateConfirmedByRole   MatchSuggestionActorRole?
  candidateConfirmedAt       DateTime?

  disputedByUserId String?
  disputedByRole   MatchSuggestionActorRole?
  disputedAt       DateTime?
  disputeReason    String?

  mergeId  String?
  reportId String?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  sourceProperty    Property @relation("MatchSuggestionSource",    fields: [sourcePropertyId],    references: [id])
  candidateProperty Property @relation("MatchSuggestionCandidate", fields: [candidatePropertyId], references: [id])
  merge  PropertyMerge? @relation("MatchSuggestionMerge",  fields: [mergeId],  references: [id])
  report Report?        @relation("MatchSuggestionReport", fields: [reportId], references: [id])

  @@unique([sourcePropertyId, candidatePropertyId], map: "match_suggestion_pair_unique")
  @@index([status, createdAt])
  @@index([sourcePropertyId])
  @@index([candidatePropertyId])
}