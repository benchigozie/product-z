enum PropertyType {
  @@type("pg/text@1")

  ESTATE
  COMPOUND
  BUILDING
  HOUSE
  APARTMENT
  HOSTEL
  SHOP
  OFFICE
  WAREHOUSE
  LAND
}

enum PropertyRelationshipType {
  @@type("pg/text@1")

  CONTAINS
}

enum PlaceType {
  @@type("pg/text@1")

  DISTRICT
  SUBDISTRICT
  AREA
}

model Country {
  id     String @id @default(cuid(2))
  name   String
  code   String @unique

  states State[]
}

model State {
  id        String @id @default(cuid(2))
  name      String
  code      String
  countryId String

  country    Country    @relation(fields: [countryId], references: [id])
  places     Place[]
  properties Property[]

  @@unique([countryId, code])
}

model Place {
  id            String    @id @default(cuid(2))
  name          String
  type          PlaceType

  stateId       String
  parentPlaceId String?

  latitude      Float?
  longitude     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  state       State @relation(fields: [stateId], references: [id])
  parentPlace Place? @relation(
    "PlaceHierarchy",
    fields: [parentPlaceId],
    references: [id]
  )
  childPlaces Place[] @relation("PlaceHierarchy")

  properties Property[]
}

model Property {
  id           String       @id @default(cuid(2))
  name         String?
  propertyType PropertyType

  countryId String
  stateId   String
  placeId   String?

  address        String?
  street         String?
  houseNumber    String?
  unitIdentifier String?
  landmark       String?

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  country Country @relation(fields: [countryId], references: [id])
  state   State   @relation(fields: [stateId], references: [id])
  place   Place?  @relation(fields: [placeId], references: [id])

  parentRelationships PropertyRelationship[] @relation("PropertyAsParent")
  childRelationships  PropertyRelationship[] @relation("PropertyAsChild")
}

model PropertyRelationship {
  id String @id @default(cuid(2))

  parentPropertyId String
  childPropertyId  String @unique

  relationshipType PropertyRelationshipType

  createdAt DateTime @default(now())

  parentProperty Property @relation(
    "PropertyAsParent",
    fields: [parentPropertyId],
    references: [id]
  )

  childProperty Property @relation(
    "PropertyAsChild",
    fields: [childPropertyId],
    references: [id]
  )
}