        "description": "create table \"intelligence\"",
        "sql": "CREATE TABLE \"public\".\"intelligence\" (\n  \"categories\" json NOT NULL,\n  \"computedAt\" timestamptz,\n  \"considerations\" json NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"evidenceThrough\" timestamptz,\n  \"failureReason\" text,\n  \"id\" text NOT NULL,\n  \"overall\" json NOT NULL,\n  \"placeId\" text,\n  \"propertyId\" text,\n  \"status\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"intelligence_status_check_38a5fb20\" CHECK (\"status\" IN ('PENDING', 'PROCESSING', 'CURRENT', 'FAILED'))\n)",
        "params": []
      }
    ],
