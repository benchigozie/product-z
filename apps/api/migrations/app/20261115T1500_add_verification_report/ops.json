        "description": "create table \"verificationReport\"",
        "sql": "CREATE TABLE \"public\".\"verificationReport\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" text NOT NULL,\n  \"latitude\" float8,\n  \"longitude\" float8,\n  \"propertyId\" text NOT NULL,\n  \"publishedAt\" timestamptz,\n  \"recordingDurationSeconds\" int4,\n  \"recordingEndedAt\" timestamptz,\n  \"recordingStartedAt\" timestamptz,\n  \"recordingUrl\" text,\n  \"requestedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"reviewNotes\" text,\n  \"reviewedAt\" timestamptz,\n  \"reviewerId\" text,\n  \"scope\" text DEFAULT 'PROPERTY' NOT NULL,\n  \"status\" text DEFAULT 'REQUESTED' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"verifierId\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"verificationReport_scope_check_2b7175c2\" CHECK (\"scope\" IN ('PROPERTY')),\n  CONSTRAINT \"verificationReport_status_check_4aeff44d\" CHECK (\"status\" IN ('REQUESTED', 'IN_PROGRESS', 'PENDING_REVIEW', 'PUBLISHED', 'REJECTED', 'CANCELLED'))\n)",
