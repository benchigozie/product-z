    "execute": [
      {
        "description": "create table \"matchSuggestion\"",
        "sql": "CREATE TABLE \"public\".\"matchSuggestion\" (\n  \"candidateConfirmedAt\" timestamptz,\n  \"candidateConfirmedByRole\" text,\n  \"candidateConfirmedByUserId\" text,\n  \"candidatePropertyId\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"disputeReason\" text,\n  \"disputedAt\" timestamptz,\n  \"disputedByRole\" text,\n  \"disputedByUserId\" text,\n  \"id\" text NOT NULL,\n  \"mergeId\" text,\n  \"reasons\" json NOT NULL,\n  \"reportId\" text,\n  \"score\" float8 NOT NULL,\n  \"sourceConfirmedAt\" timestamptz,\n  \"sourceConfirmedByRole\" text,\n  \"sourceConfirmedByUserId\" text,\n  \"sourcePropertyId\" text NOT NULL,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"matchSuggestion_candidateConfirmedByRole_check_5f2bbd35\" CHECK (\"candidateConfirmedByRole\" IN ('CREATOR', 'AGENT', 'LANDLORD', 'TENANT', 'OPS', 'ADMIN')),\n  CONSTRAINT \"matchSuggestion_disputedByRole_check_2534f9ff\" CHECK (\"disputedByRole\" IN ('CREATOR', 'AGENT', 'LANDLORD', 'TENANT', 'OPS', 'ADMIN')),\n  CONSTRAINT \"matchSuggestion_sourceConfirmedByRole_check_24c86f6e\" CHECK (\"sourceConfirmedByRole\" IN ('CREATOR', 'AGENT', 'LANDLORD', 'TENANT', 'OPS', 'ADMIN')),\n  CONSTRAINT \"matchSuggestion_status_check_73c7ad9a\" CHECK (\"status\" IN ('PENDING', 'PARTIALLY_CONFIRMED', 'CONFIRMED', 'DISPUTED', 'EXPIRED'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"matchSuggestion\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
